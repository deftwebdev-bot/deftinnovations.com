# Django Core Settings
SECRET_KEY=django-insecure-deft-innovations-change-this-in-production-random-key
DEBUG=True
ALLOWED_HOSTS=*

# Database Connection (PostgreSQL Example or SQLite default)
# Format for PostgreSQL: postgresql://postgres:password@localhost:5432/deft_db
# Format for Neon/Supabase: postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# CORS & Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://deftinnovations.com

# Email Alerts
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@deftinnovations.com
