# ============================================================
# Deft Innovations — Backend environment (production template)
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ============================================================

# ─── Django core ─────────────────────────────────────────────
# REQUIRED in production. Generate a strong key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-deft-innovations-change-this-in-production-random-key
# NEVER True in production. The app refuses to boot with DEBUG=False unless
# SECRET_KEY / ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS are properly set.
DEBUG=False
# REQUIRED in production — comma-separated domains of the Django backend itself.
ALLOWED_HOSTS=api.deftinnovations.com,deftinnovations.com,www.deftinnovations.com

# ─── Database ────────────────────────────────────────────────
# PostgreSQL (Neon/Supabase/RDS all work). Use sslmode=require for managed DBs.
# Format: postgres://user:password@host:5432/dbname
# IMPORTANT: Always specify the host explicitly (127.0.0.1 or a hostname).
# Using postgres:///dbname (Unix socket without host) causes a slow DNS lookup
# on macOS, adding 5–30 seconds to every server startup.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/deftinnovations_db

# ─── CORS / CSRF (frontend origin that calls this API) ───────
CORS_ALLOWED_ORIGINS=https://deftinnovations.com,https://www.deftinnovations.com
# Origins trusted for CSRF-protected POSTs (admin logins, form submissions
# proxied through the frontend host). Include scheme, no trailing slash.
CSRF_TRUSTED_ORIGINS=https://deftinnovations.com,https://www.deftinnovations.com

# ─── Security / TLS ──────────────────────────────────────────
# Set True only when TLS terminates at your app (behind nginx/Cloudflare with
# HTTPS->HTTP forwarding, leave False and rely on SECURE_PROXY_SSL_HEADER).
SECURE_SSL_REDIRECT=False
# HSTS max-age in seconds. 31536000 = 1 year (recommended once HTTPS is stable).
SECURE_HSTS_SECONDS=31536000

# ─── Cache / rate-limit store ────────────────────────────────
# REQUIRED in production for correctness: the in-memory fallback is per-worker,
# so API response caching, the media-proxy allowlist, and rate limiting would
# each be inconsistent across gunicorn workers without a shared Redis.
REDIS_URL=redis://127.0.0.1:6379/1

# ─── Email (lead/application alerts) ─────────────────────────
# Production example (choose one provider):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.postmarkapp.com  EMAIL_PORT=587
#   EMAIL_HOST_USER=your-key  EMAIL_HOST_PASSWORD=your-secret
#   EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@deftinnovations.com
